{
  "name": "frostline-ops",
  "version": "1.0.0",
  "private": true,
  "description": "FrostLine operations CRM — service, scheduling, field attendance, quoting and inventory",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "setup": "npm run db:reset",
    "db:migrate": "tsx src/cli.ts migrate",
    "db:seed": "tsx src/cli.ts seed",
    "db:reset": "tsx src/cli.ts reset",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
